  16:Core/Src/main.c **** #define PIN_HIGH(port, pin)       ((port)->BSRR = (1U << (pin)))
  17:Core/Src/main.c **** #define PIN_LOW(port, pin)        ((port)->BSRR = (1U << ((pin) + 16)))
  18:Core/Src/main.c **** #define PIN_WRITE(port, pin, val) ((port)->BSRR = (val) ? (1U << (pin)) : (1U << ((pin) + 16)))
  19:Core/Src/main.c **** 
  20:Core/Src/main.c **** #define OE_ON()   PIN_HIGH(GPIOE, PIN_OE)
  21:Core/Src/main.c **** #define OE_OFF()  PIN_LOW(GPIOE, PIN_OE)
