 107:Core/Src/main.c **** void p10_render_frame(void) {
 108:Core/Src/main.c ****     for (uint8_t row = 0; row < 4; row++) {
 109:Core/Src/main.c ****         OE_OFF();
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****         if (row & 1) PIN_HIGH(PIN_A); else PIN_LOW(PIN_A);
 112:Core/Src/main.c ****         if (row & 2) PIN_HIGH(PIN_B); else PIN_LOW(PIN_B);
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****         for (int i = 0; i < 16; i++) {
 115:Core/Src/main.c ****             p10_send_byte(frame_buffer[row][i]);
 116:Core/Src/main.c ****         }
